# ============================================================
# AI Document Metadata Extraction - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Ollama settings ──────────────────────────────────────────
# Base URL for the Ollama server (default: local instance)
OLLAMA_BASE_URL=http://localhost:11434

# Pretrained model to use for semantic extraction.
# Recommended: qwen2.5:7b  (good balance of accuracy and speed)
# Alternatives: llama3.2:3b, mistral:7b, phi3:mini
OLLAMA_MODEL=qwen2.5:7b

# Request timeout in seconds when calling the LLM
OLLAMA_TIMEOUT=120

# Number of GPU layers to offload to Ollama.
# Set to 0 to run strictly on CPU (recommended for laptops with 4GB VRAM
# or if you encounter "CUDA error: device kernel image is invalid").
OLLAMA_NUM_GPU=0

# ── Upload limits ─────────────────────────────────────────────
# Maximum file size in megabytes (applied per file)
MAX_UPLOAD_SIZE_MB=20

# ── Few-shot learning ─────────────────────────────────────────
# Set to true to prepend few-shot examples to the extraction prompt.
# Disable to reduce token usage if the model struggles with long prompts.
FEW_SHOT_ENABLED=true

# Maximum number of few-shot examples to include (1–5 recommended)
FEW_SHOT_MAX_EXAMPLES=3

# ── Confidence thresholds ────────────────────────────────────
# Fields with confidence below LOW_CONFIDENCE_THRESHOLD will
# display a warning in the UI.
LOW_CONFIDENCE_THRESHOLD=0.5

# Fields with confidence below REVIEW_THRESHOLD will be flagged
# for manual review in the evaluation report.
REVIEW_THRESHOLD=0.3

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
